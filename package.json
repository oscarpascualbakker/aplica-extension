{
  "name": "aplica-extension",
  "version": "0.2.0",
  "private": true,
  "description": "Browser extension for Aplica (aplica.cv)",
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.23.5"
  },
  "scripts": {
